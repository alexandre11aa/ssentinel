# Token exigido em todos os endpoints (exceto /health).
# Enviar no header:  Authorization: Bearer <token>   ou   x-api-key: <token>
API_TOKEN=

# JID do grupo monitorado (termina em @g.us).
# Não sabe qual é? Deixe vazio, suba o serviço e chame GET /groups.
WHATSAPP_GROUP_JID=

PORT=8082
LOG_LEVEL=warn

# Quantidade de mensagens recebidas mantidas em memória (GET /messages).
MESSAGE_BUFFER_SIZE=500

WHATSAPP_MAX_QR_ATTEMPTS=3

# IA. Chave grátis em https://aistudio.google.com
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Palavras que disparam a IA, separadas por vírgula (basta uma na mensagem).
AI_KEYWORDS=sentinel, sentinela

# Quantas mensagens de texto anteriores à palavra-chave vão como contexto para a IA (0 = nenhuma).
# Precisa ser menor que MESSAGE_BUFFER_SIZE.
AI_CONTEXT_MESSAGES=5

# true = a IA responde também às mensagens do próprio número do bot (útil para testar).
# false = responde só aos outros participantes do grupo.
DEBUG=true

# Instruções enviadas junto da mensagem. Uma linha; use \n para quebrar linha.
# O preprompt manda a IA responder exatamente [IGNORE] quando a mensagem (e a janela de
# contexto anterior) não tem assunto real; o código então não envia nada ao grupo.
# Se mudar esse marcador aqui, mude também IGNORE_MARKER em src/ai.js.
PREPROMPT="Você é um assistente de inteligência artificial que responde apenas com informações verdadeiras e baseadas em fatos.  Se for só a palavra-chave solta, texto aleatório, piada sem contexto, saudação, spam ou algo sem relação, responda exatamente: [IGNORE] (sem mais nenhum texto)."
